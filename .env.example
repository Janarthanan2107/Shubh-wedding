# Copy to .env. Never commit real secrets.
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/shubh?schema=public"
SESSION_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional S3-compatible storage (Cloudflare R2). Leave blank to use local disk.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# Optional Razorpay live keys. The app ships a mock gateway and does not require these.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
